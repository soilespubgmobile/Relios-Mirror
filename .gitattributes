# Line endings are the same on every computer (also in the source code the build on GitHub packs):
# LF everywhere (the shell script needs it), CRLF for the Windows batch file.
* text=auto eol=lf
*.bat text eol=crlf
*.ico binary
*.bmp binary
# test messages captured from devices (tests/fixtures): bytes, never changed
tests/fixtures/** binary
tests/fixtures/**/*.txt text eol=lf
